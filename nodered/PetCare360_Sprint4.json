    "id": "fn_alert",
    "type": "function",
    "z": "tab_petcare360",
    "name": "Alertas inteligentes",
    "func": "const d = msg.payload || {};\nconst ia = d.analiseIA;\nif (!ia) {\n    return null;\n}\nconst nome = d.nome || \"Pet\";\nif (ia.nivel === \"ALTO\") {\n    return { payload: `⚠️ PRIORIDADE ALTA — ${nome}: alerta registrado para o tutor e a clínica.` };\n}\nif (ia.nivel === \"ATENÇÃO\") {\n    return { payload: `🔶 ATENÇÃO — ${nome}: acompanhar indicadores nas próximas horas.` };\n}\nreturn { payload: `✅ ${nome}: sem alertas no momento.` };",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
