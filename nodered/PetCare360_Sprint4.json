  {
    "id": "fn_hist_chart",
    "type": "function",
    "z": "tab_petcare360",
    "name": "Montar gráfico do histórico",
    "func": "const h = msg.payload || {};\nconst analises = Array.isArray(h.analises) ? h.analises : [];\nconst r = h.resumo || {};\nconst pontos = analises.map(a => ({ x: new Date(a.dataAnalise).getTime(), y: a.irp }));\nconst resumo = r.totalAnalises\n    ? `${msg.nomePet}: ${r.totalAnalises} análises • IRP médio ${r.mediaIrp} • último nível ${r.ultimoNivel}`\n    : `${msg.nomePet}: nenhuma análise registrada ainda.`;\nreturn [\n    { payload: [{ series: [msg.nomePet], data: [pontos], labels: [\"\"] }] },\n    { payload: resumo }\n];",
