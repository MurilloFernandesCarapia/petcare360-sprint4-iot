  {
    "id": "fn_form_request",
    "type": "function",
    "z": "tab_petcare360",
    "name": "Aplicação - enviar para API REST",
    "func": "const d = msg.payload || {};\nconst numero = v => (v === \"\" || v === null || v === undefined) ? undefined : Number(v);\nconst texto = v => (v === \"\" || v === null || v === undefined) ? undefined : String(v);\nmsg.payload = {\n    petId: numero(d.petId),\n    nome: texto(d.nome),\n    especie: texto(d.especie),\n    raca: texto(d.raca),\n    idade: numero(d.idade),\n    peso: numero(d.peso),\n    temperatura: numero(d.temperatura),\n    umidade: numero(d.umidade),\n    atividade: numero(d.atividade),\n    alimentacao: numero(d.alimentacao),\n    comportamento: d.comportamentoAlterado ? \"Alterado\" : \"Normal\",\n    origem: \"dashboard\"\n};\nmsg.method = \"POST\";\nmsg.url = env.get(\"PETCARE360_API_URL\") || \"http://127.0.0.1:1880/api/ia/analisar\";\nmsg.headers = { \"content-type\": \"application/json\" };\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
