  {
    "id": "fn_rf_result",
    "type": "function",
    "z": "tab_petcare360",
    "name": "Validar resposta da IA",
    "func": "const ok = msg.statusCode >= 200 && msg.statusCode < 300 && msg.payload && msg.payload.analiseIA;\nif (ok) {\n    return [msg, null];\n}\nconst status = Number(msg.statusCode);\nmsg.payload = { erro: \"Falha ao consultar o serviço de IA\", status: status || null, detalhe: msg.payload || null };\nmsg.statusCode = status >= 400 && status < 500 ? status : 502;\nreturn [null, msg];",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
