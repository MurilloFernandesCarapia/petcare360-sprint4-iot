  {
    "id": "fn_dashboard",
    "type": "function",
    "z": "tab_petcare360",
    "name": "Preparar dashboard",
    "func": "const d = msg.payload || {};\nconst ia = d.analiseIA;\nconst t = d.telemetria;\nif (!ia || !t) {\n    return null;\n}\nconst p = d.perfil || {};\nconst meds = ia.medicamentosAtivos;\nconst medicamentos = meds === null || meds === undefined\n    ? \"Não consultado (Oracle não configurado)\"\n    : (meds.length ? meds.join(\", \") : \"Nenhum medicamento ativo\");\nconst atividade = t.origemAtividade === \"acelerometro\" ? `${t.atividade} (acelerômetro)` : t.atividade;\nreturn [\n    { payload: t.temperatura },\n    { payload: t.umidade },\n    { payload: t.atividade },\n    { payload: t.alimentacao },\n    { payload: `${d.nome} — ${d.especie}, ${d.raca}, ${d.idade ?? \"-\"} anos (${p.faixaEtaria || \"-\"})` },\n    { payload: ia.nivel },\n    { payload: ia.irp },\n    { payload: ia.recomendacao },\n    { payload: ia.motivos.join(\" • \") },\n    { payload: medicamentos },\n    { payload: `${ia.tendencia.status} — ${ia.tendencia.descricao}` }\n];",
    "outputs": 11,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
