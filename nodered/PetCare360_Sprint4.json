    "id": "fn_hist_request",
    "type": "function",
    "z": "tab_petcare360",
    "name": "Buscar histórico do pet",
    "func": "const pets = { 1: \"Rex\", 25: \"Rex\", 27: \"Loro\", 42: \"Rex\", 61: \"Thor\", 81: \"Thorzinho\", 101: \"Pipoca\" };\nconst analise = typeof msg.payload === \"object\" && msg.payload !== null ? msg.payload : null;\nconst petId = analise ? analise.petId : Number(msg.payload);\nif (!petId) {\n    return null;\n}\nconst base = env.get(\"PETCARE360_AI_BASE_URL\") || \"http://127.0.0.1:8000\";\nreturn {\n    url: `${base}/api/ia/pets/${petId}/historico?limite=20`,\n    method: \"GET\",\n    nomePet: (analise && analise.nome) || pets[petId] || `Pet ${petId}`\n};",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
