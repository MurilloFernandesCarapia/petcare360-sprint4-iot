  {
    "id": "fn_simulator",
    "type": "function",
    "z": "tab_petcare360",
    "name": "Simulador IoT (coleira)",
    "func": "const cenarios = {\n    normal: { temperatura: 38.3, umidade: 55, amplitude: 0.68, alimentacao: 90, comportamento: \"Normal\" },\n    atencao: { temperatura: 39.3, umidade: 68, amplitude: 0.36, alimentacao: 50, comportamento: \"Alterado\" },\n    alto: { temperatura: 39.8, umidade: 72, amplitude: 0.19, alimentacao: 35, comportamento: \"Alterado\" }\n};\nconst c = cenarios[msg.payload] || cenarios.normal;\nconst ruido = () => (Math.random() - 0.5) * 0.02;\nconst acelerometro = [];\nfor (let i = 0; i < 50; i++) {\n    const fase = (i / 50) * 2 * Math.PI * 4;\n    acelerometro.push([\n        Number(ruido().toFixed(3)),\n        Number(ruido().toFixed(3)),\n        Number((1 + c.amplitude * Math.sin(fase) + ruido()).toFixed(3))\n    ]);\n}\nmsg.topic = \"petcare360/sprint4/telemetria\";\nmsg.payload = {\n    petId: 61,\n    nome: \"Thor\",\n    especie: \"Cachorro\",\n    raca: \"Golden Retriever\",\n    idade: 4,\n    peso: 30.5,\n    temperatura: c.temperatura,\n    umidade: c.umidade,\n    alimentacao: c.alimentacao,\n    comportamento: c.comportamento,\n    acelerometro,\n    origem: \"coleira-mqtt\",\n    timestamp: new Date().toISOString()\n};\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 380,
    "y": 340,
    "wires": [
      [
        "mqtt_out"
      ]
    ]
  },
